LLM_PROVIDER=gemini
GEMINI_API_KEY = your_key_here
GEMINI_MODEL=gemini-3.8-flash
DATABASE_URL= postgresql+psycopg://postgres:postgres@localhost:5432/incident_copilot
WINDOW_SECONDS=10
WARMUP_WINDOWS=30
ANOMALY_GAP_SECONDS=30
TOP_K_TEMPLATES=30
WINDOW_GRACE_SECONDS=5
HST_N_TREES=25
HST_HEIGHT=15
HST_WINDOW_SIZE=100
THRESHOLD_LOOKBACK=200
THRESHOLD_STD_MULT=3.0
CONSECUTIVE_HIGH_WINDOWS=2
INCIDENT_COOLDOWN_SECONDS=60
MAX_AGENT_TOOL_CALLS=5
DRAIN_STATE_PATH=data/drain_state.bin
METRICS_SAMPLE_SECONDS=5
