.env
*.log
data/

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Type / lint caches
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.iml

# Docker volumes (if accidentally created locally)
pg_data/

# OS
.DS_Store
Thumbs.db
